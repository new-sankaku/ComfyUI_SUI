{
    "name": "comfyui-sui",
    "version": "1.0.0",
    "private": true,
    "description": "ComfyUI Simple User Interface",
    "scripts": {
        "lint": "eslint js/",
        "lint:fix": "eslint js/ --fix",
        "format": "prettier --write \"js/**/*.js\" \"css/**/*.css\" \"*.html\"",
        "format:check": "prettier --check \"js/**/*.js\" \"css/**/*.css\" \"*.html\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "husky"
    },
    "lint-staged": {
        "js/**/*.js": [
            "eslint --fix",
            "prettier --write"
        ],
        "css/**/*.css": [
            "prettier --write"
        ],
        "*.html": [
            "prettier --write"
        ]
    },
    "devDependencies": {
        "eslint": "^9.0.0",
        "globals": "^16.0.0",
        "prettier": "^3.0.0",
        "vitest": "^3.0.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0"
    }
}
